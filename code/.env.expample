#################################################################
# LLM (Large Language Model) Configuration
#################################################################

# Specifies which LLM backend to use. The application logic will
# change based on this value.
# Accepted values: "vllm", "ollama", "lmstudio", "openai"
LLM_BACKEND="vllm"


# --- vLLM Settings (only used if LLM_BACKEND="vllm") ---
# The full URL to your vLLM OpenAI-compatible API server.
VLLM_BASE_URL="http://127.0.0.1:8000"

# The model identifier that MUST EXACTLY MATCH the 'id' reported by
# the vLLM server's /v1/models endpoint.
VLLM_MODEL="/llm_models/Qwen2.5-Coder-1.5B-Instruct"


# --- Ollama Settings (only used if LLM_BACKEND="ollama") ---
# The URL to your Ollama server.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# The name of the model you want to use from Ollama.
OLLAMA_MODEL="llama3:instruct"


# --- LMStudio Settings (only used if LLM_BACKEND="lmstudio") ---
# The URL to your LMStudio local server.
LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"

# The model identifier loaded in LMStudio.
LMSTUDIO_MODEL="local-model/gguf-model.gguf"


# --- OpenAI Settings (only used if LLM_BACKEND="openai") ---
# Your API key for OpenAI.
OPENAI_API_KEY="sk-..."


#################################################################
# TTS and STT Configuration
#################################################################
# Note: In the current version of server.py, some of these are still
# hardcoded. For full flexibility, these would also be loaded via os.getenv().

# The Text-to-Speech engine to use.
# Currently HARDCODED in server.py as TTS_START_ENGINE = "coqui"
# Accepted values: "coqui", "orpheus", "kokoro"
TTS_ENGINE="coqui"

# The Speech-to-Text engine to use.
# Currently HARDCODED in server.py as STT_ENGINE="whisper"
# Accepted values: "whisper"
STT_ENGINE="whisper"

# The size of the Whisper model to load for STT. Smaller models are faster
# but less accurate. 'small' is a good balance for local use.
# Currently HARDCODED in server.py.
# Accepted values: "tiny", "base", "small", "medium", "large"
STT_MODEL="small"


#################################################################
# Application & Server Configuration
#################################################################

# Sets the logging level for more or less detailed terminal output.
# Accepted values: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL="INFO"

# The maximum number of audio chunks to hold in memory before dropping
# them. This prevents runaway memory usage if processing falls behind.
MAX_AUDIO_QUEUE_SIZE=50